APP_NAME=Finance Management Platform
ENVIRONMENT=development
# Postgres, not SQLite: migration 20260907_postgres_rls uses Postgres-only
# DDL (CREATE FUNCTION ... plpgsql), so `alembic upgrade head` fails on
# SQLite partway through -- confirmed 2026-09-13 trying to start the app
# fresh against the old sqlite:///./finance.db default. Point this at a
# local Postgres role/database (see CLAUDE.md's RLS pre-push hook section
# for how to set one up); SQLite remains fine for the unit test suite,
# which stops before that migration matters.
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe subscription/billing (FR-12.x) -- test-mode keys only; no real
# secret store exists yet, same disclosed gap as SECRET_KEY above.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_TRIAL_DAYS=14
STRIPE_PLAN_AMOUNT_CENTS=999
STRIPE_PLAN_CURRENCY=usd
BILLING_GRACE_PERIOD_DAYS=7
FRONTEND_BASE_URL=http://localhost:5173

# Production: same DATABASE_URL shape as above, pointed at the real
# production database (e.g. Render's managed Postgres connection string),
# plus:
# ENVIRONMENT=production
